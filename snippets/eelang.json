{
  "assert-pattern": {
    "prefix": "assertp",
    "body": ["assert ${1:pattern} = ${2:value}"],
    "description": "eelang assert-pattern (assert P = e)"
  },
  "assert-patterns": {
    "prefix": "assertps",
    "body": ["assert ${1:p1} = ${2:e1}, ${3:p2} = ${4:e2} if ${5:guard}"],
    "description": "eelang assert-pattern with several bindings and a guard"
  },
  "match-def": {
    "prefix": "matchdef",
    "body": [
      "match def ${1:name}(${2:params}):",
      "    case ${3:pattern} = ${4:value}:",
      "        ${5:pass}"
    ],
    "description": "eelang match-def function"
  },
  "match-def-guard": {
    "prefix": "matchguard",
    "body": [
      "match def ${1:name}(${2:params}):",
      "    case if ${3:guard}:",
      "        ${4:pass}"
    ],
    "description": "eelang match-def guard-only clause"
  },
  "pipeline": {
    "prefix": "pipe",
    "body": [
      "${1:name} =",
      "    ${2:value}",
      "    ..${3:func}(${4:args})"
    ],
    "description": "eelang block pipeline"
  },
  "pipeline-inline": {
    "prefix": "pipecall",
    "body": "${1:value} ..${2:func}(${3:args})",
    "description": "eelang inline pipeline call (value is passed last)"
  },
  "pipeline-block": {
    "prefix": "pipeblock",
    "body": "${1:value} ..${2:func}: ${3:argument}",
    "description": "eelang inline pipeline block (block is passed first)"
  },
  "pipeline-match": {
    "prefix": "pipematch",
    "body": [
      "${1:name} =",
      "    ${2:value}",
      "    ..match:",
      "        case ${3:pattern}:",
      "            ${4:expression}"
    ],
    "description": "eelang ..match: pipeline step (non-destructive)"
  },
  "pipeline-assert": {
    "prefix": "pipeassert",
    "body": [
      "${1:name} =",
      "    ${2:value}",
      "    ..assert: ${3:pattern}"
    ],
    "description": "eelang ..assert: pipeline step (raises MatchError on failure)"
  }
}
